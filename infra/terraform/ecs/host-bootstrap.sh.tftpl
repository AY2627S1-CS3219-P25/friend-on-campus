#!/bin/bash
# AI Assistance Disclosure:
# Tool: Codex (model: GPT-6), date: 2026-11-09
# Scope: Wire optional self-hosted observability for the approved ECS layout.
# Author review: <to be completed by yanhwee>
#
# Tool: Codex (model: GPT-6), date: 2026-11-08
# Scope: Attach the retained broker disk and publish the slot's private DNS before ECS starts.
# Author review: <to be completed by the author>

# AI-generated (edited by ngkhengyang)
set -euo pipefail
mkdir -p /etc/systemd/system/ecs.service.d /etc/ecs /srv/rabbitmq
cat >/etc/systemd/system/ecs.service.d/broker-volume.conf <<'EOF'
[Service]
ExecStartPre=/usr/bin/mountpoint -q /srv/rabbitmq
EOF
systemctl daemon-reload

export AWS_DEFAULT_REGION=ap-southeast-1
export AWS_RETRY_MODE=standard AWS_MAX_ATTEMPTS=8
token=$(curl -fsS --retry 5 -X PUT -H 'X-aws-ec2-metadata-token-ttl-seconds: 120' http://169.254.169.254/latest/api/token)
instance=$(curl -fsS -H "X-aws-ec2-metadata-token: $token" http://169.254.169.254/latest/meta-data/instance-id)
address=$(curl -fsS -H "X-aws-ec2-metadata-token: $token" http://169.254.169.254/latest/meta-data/local-ipv4)

command -v aws >/dev/null || dnf install -y awscli-2
volume='${volume}'
device="/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_$${volume//-/}"
for attempt in $(seq 1 60); do
    [ ! -b "$device" ] || break
    state=$(aws ec2 describe-volumes --volume-ids "$volume" --query 'Volumes[0].State' --output text)
    if [ "$state" = available ]; then
        aws ec2 attach-volume --volume-id "$volume" --instance-id "$instance" --device /dev/sdf
    fi
    sleep 5
done
test -b "$device"
if ! blkid "$device" >/dev/null; then
    mkfs.xfs "$device"
fi
test "$(blkid -s TYPE -o value "$device")" = xfs
uuid=$(blkid -s UUID -o value "$device")
grep -q ' /srv/rabbitmq ' /etc/fstab || printf 'UUID=%s /srv/rabbitmq xfs defaults,nofail 0 2\n' "$uuid" >>/etc/fstab
mountpoint -q /srv/rabbitmq || mount /srv/rabbitmq

%{ if observability_volume != "" ~}
mkdir -p /srv/observability
obs_volume='${observability_volume}'
obs_device="/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_$${obs_volume//-/}"
for attempt in $(seq 1 60); do
    [ ! -b "$obs_device" ] || break
    obs_state=$(aws ec2 describe-volumes --volume-ids "$obs_volume" --query 'Volumes[0].State' --output text)
    if [ "$obs_state" = available ]; then
        aws ec2 attach-volume --volume-id "$obs_volume" --instance-id "$instance" --device /dev/sdg
    fi
    sleep 5
done
test -b "$obs_device"
if ! blkid "$obs_device" >/dev/null; then mkfs.xfs "$obs_device"; fi
test "$(blkid -s TYPE -o value "$obs_device")" = xfs
obs_uuid=$(blkid -s UUID -o value "$obs_device")
grep -q ' /srv/observability ' /etc/fstab || printf 'UUID=%s /srv/observability xfs defaults,nofail 0 2\n' "$obs_uuid" >>/etc/fstab
mountpoint -q /srv/observability || mount /srv/observability
cat >/etc/systemd/system/ecs.service.d/observability-volume.conf <<'EOF'
[Service]
ExecStartPre=/usr/bin/mountpoint -q /srv/observability
EOF
systemctl daemon-reload
%{ endif ~}

aws route53 change-resource-record-sets --hosted-zone-id '${zone_id}' --change-batch \
  "{\"Changes\":[{\"Action\":\"UPSERT\",\"ResourceRecordSet\":{\"Name\":\"${name}\",\"Type\":\"A\",\"TTL\":10,\"ResourceRecords\":[{\"Value\":\"$address\"}]}}]}"

cat >/etc/ecs/ecs.config <<'EOF'
ECS_CLUSTER=${cluster}
ECS_INSTANCE_ATTRIBUTES={"broker-slot":"${slot}"%{ if observability_volume != "" },"observability-storage":"ready"%{ endif }}
ECS_RESERVED_MEMORY=1024
ECS_ENABLE_AWSLOGS_EXECUTIONROLE_OVERRIDE=true
%{ if observability_volume != "" ~}
ECS_ENABLE_TASK_IAM_ROLE_NETWORK_HOST=true
%{ endif ~}
ECS_DYNAMIC_HOST_PORT_RANGE=32768-65535
EOF
systemctl enable --now --no-block ecs.service
