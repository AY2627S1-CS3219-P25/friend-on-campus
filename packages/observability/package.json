{
  "name": "@campus-errand/observability",
  "version": "1.0.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.301.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.301.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.0",
    "@opentelemetry/instrumentation-express": "0.73.0",
    "@opentelemetry/instrumentation-http": "0.301.0",
    "@opentelemetry/instrumentation-runtime-node": "0.38.0",
    "@opentelemetry/instrumentation-undici": "0.35.0",
    "@opentelemetry/sdk-logs": "3.1.0",
    "@opentelemetry/sdk-metrics": "3.1.0",
    "@opentelemetry/sdk-node": "0.301.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5",
    "@opentelemetry/sdk-trace": "3.1.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./bootstrap": {
      "types": "./src/bootstrap.ts",
      "default": "./src/bootstrap.ts"
    }
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
