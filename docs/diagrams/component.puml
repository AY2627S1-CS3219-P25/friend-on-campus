@startuml component
!pragma layout smetana
title Friend on Campus — component diagram, as built (main @ fcd5371)
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam ArrowFontSize 10

package "Clients (browser)" {
  [<size:16>Admin portal</size>\n<size:12>React, Vite :5174</size>\n\n<size:10>Admin supplier and user management</size>] as AP
  [<size:16>Friend on Campus</size>\n<size:12>React, Vite :5173</size>\n\n<size:10>Student-facing errand app</size>] as SA
}

node "api-gateway\nnginx :80\n(routes only)" as GW

package "Services" {
  component "<size:18>User Service</size>\n<size:12>Express, TypeScript, Prisma :8001</size>\n\n<size:11>Accounts, sessions and roles</size>" as US
  rectangle "<size:18>Supplier Service</size>\n<size:12>Express, TypeScript, Prisma :8002</size>\n\n<size:11>Supplier directory and management</size>" as SS
  rectangle "<size:18>Order Service</size>\n<size:12>Express, TypeScript :8003</size>\n\n<size:11><i>To be implemented</i></size>" as OS
  rectangle "<size:18>Credit Service</size>\n<size:12>Express, TypeScript :8004</size>\n\n<size:11><i>To be implemented</i></size>" as CS
}

database "PostgreSQL 16 (one server)" {
  database "User DB\n" as UDB
  database "Supplier DB\n" as SDB
  database "Order DB\n" as ODB
  database "Credit DB\n" as CDB
}

' ---- control flow: HTTP requests (solid, black)
SA --> GW : "/ , /api/*"
AP --> US : "/api/users\n(Vite proxy on :5174)"
AP --> SS : "/api/suppliers\n(Vite proxy on :5174)"
GW --> US : "/api/users/"
GW --> SS : "/api/suppliers"
GW --> OS : "/api/orders"
GW --> CS : "/api/credits/"

' ---- data flow: reads and writes (solid, blue)
US -[#1F5FBF]-> UDB : "read/write\nusers, sessions"
SS -[#1F5FBF]-> SDB : "read/write\nsuppliers"

legend right
  |= Symbol |= Meaning |
  | black solid arrow | control flow: HTTP request, in the direction of the call |
  | <color:#1F5FBF>blue solid arrow</color> | data flow: database read/write |
  | database | backing store; order_db and credit_db are provisioned but unused |
endlegend

@enduml
