' Render: java -jar plantuml.jar -tsvg component.puml   (or paste into https://www.plantuml.com/plantuml)
@startuml component
!pragma layout smetana
title Friend on Campus — component diagram, as built
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam ArrowFontSize 10

skinparam rectangle {
  BackgroundColor<<mock>> #F4F4F4
  BorderStyle<<mock>> dashed
}

package "Clients (browser)" {
  [student-app\nReact + Vite :5173] as SA
  [admin-portal\nReact + Vite :5174] as AP
}

node "api-gateway\nnginx :80\n(routes only, no auth)" as GW

package "Real services (Node + Express + Prisma)" {
  [user-service :8001\nsigns access tokens\nwith the Ed25519 private key] as US
  [supplier-service :8002\nverifies access tokens\nwith the public key] as SS
  [credit-service :8004\nverifies tokens\nconsumes events] as CS
  [notification-service :8005\nverifies tokens\nconsumes events, WebSocket push] as NS
}

package "In-memory mock (starter template)" {
  rectangle "order-service :8003" <<mock>> as OS
}

package "Shared packages (compile-time)" {
  [@campus-errand/auth\nauthMiddleware, requireAdmin] as AUTH
  [@campus-errand/common-dtos] as DTO
}

database "PostgreSQL 16 (one server)" {
  database "user_db\nusers, sessions" as UDB
  database "supplier_db\nsuppliers" as SDB
  database "order_db\nempty" as ODB
  database "credit_db\nwallets, transactions, escrows" as CDB
  database "notification_db\nnotifications" as NDB
}

queue "RabbitMQ 3.13\ncampus.events topic exchange" as MQ

' ---- control flow: HTTP / WebSocket requests (solid, black)
SA --> GW : "/ , /api/*, /ws/"
AP --> GW : "/api/* via Vite proxy"
GW --> US : "/api/auth/, /api/users[/]"
GW --> SS : "/api/suppliers"
GW --> OS : "/api/orders"
GW --> CS : "/api/credits[/]"
GW --> NS : "/api/notifications[/], /ws/"
CS -[#1F5FBF]-> CDB : "read/write"
NS -[#1F5FBF]-> NDB : "read/write\nnotifications"
US --> MQ : "publish user.registered"
MQ --> CS : "consume"
MQ --> NS : "consume order.*"

' ---- data flow: reads and writes (solid, blue)
US -[#1F5FBF]-> UDB : "read/write\nusers, sessions"
SS -[#1F5FBF]-> SDB : "read/write\nsuppliers"

' keep RabbitMQ beside the databases
CDB -[hidden]- MQ

' ---- compile-time dependency (dotted)
US ..> AUTH : uses
SS ..> AUTH : uses
US ..> DTO : types
SS ..> DTO : types

legend right
  |= Symbol |= Meaning |
  | black solid arrow | control flow: HTTP or WebSocket request, in the direction of the call |
  | <color:#1F5FBF>blue solid arrow</color> | data flow: database read/write |
  | dotted arrow | compile-time dependency (import), no runtime call |
  | dashed grey box | in-memory mock from the starter template |
  | database / queue | backing store; order_db is provisioned but unused |
endlegend

note right of SS
  Verifies tokens locally with JWT_PUBLIC_KEY,
  issuer and audience. Never calls user-service.
end note
note left of GW
  http://localhost/admin/ serves the admin portal.
  Unknown /api/ paths return 404.
end note
@enduml
