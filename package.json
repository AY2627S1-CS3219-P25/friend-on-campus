{
  "name": "nus-campus-errand-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "NUS CampusErrand Peer-to-Peer Campus Errand Platform (CS3219 AY26/27)",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.3"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:apps": "node scripts/dev.mjs apps",
    "dev:services": "node scripts/dev.mjs services",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node scripts/ci/run-all-tests.mjs",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:messaging": "npm run test:messaging --workspaces --if-present",
    "test:migration": "npm run test:migration --workspaces --if-present",
    "test:seed": "npm run test:seed --workspaces --if-present",
    "test:acceptance": "node scripts/uat/uat-d2-api.mjs && node scripts/uat/uat-notifications.mjs && node scripts/uat/uat-cdc.mjs",
    "test:e2e": "node scripts/ci/run-all-tests.mjs --system-only",
    "test:e2e:api": "tsx scripts/test-d2-e2e.ts",
    "test:e2e:ui": "node scripts/uat/uat-d2-ui.mjs",
    "test:e2e:ui:realtime": "node scripts/uat/uat-realtime.mjs",
    "coverage": "node scripts/coverage.mjs",
    "ci:validate-tests": "node scripts/ci/validate-test-matrix.mjs",
    "db:deploy": "npm run db:deploy --workspaces --if-present",
    "db:seed": "npm run db:seed -w @campus-errand/user-service -w @campus-errand/supplier-service -w @campus-errand/order-service -w @campus-errand/credit-service",
    "generate:jwt-keys": "node scripts/generate-jwt-keys.mjs",
    "postinstall": "npm run db:generate --workspaces --if-present"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/amqplib": "^0.10.5",
    "@types/node": "^20.14.0",
    "amqplib": "^0.10.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "pg": "^8.11.5",
    "playwright": "1.64.0",
    "tsx": "^4.11.0",
    "typescript-eslint": "^8.71.1"
  }
}
