{
  "name": "nus-campus-errand-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "NUS CampusErrand Peer-to-Peer Campus Errand Platform (CS3219 AY26/27)",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.3"
  },
  "scripts": {
    "dev:student": "npm run dev --workspace=@campus-errand/student-app",
    "dev:admin": "npm run dev --workspace=@campus-errand/admin-portal",
    "dev:user": "npm run dev --workspace=@campus-errand/user-service",
    "dev:supplier": "npm run dev --workspace=@campus-errand/supplier-service",
    "dev:order": "npm run dev --workspace=@campus-errand/order-service",
    "dev:credit": "npm run dev --workspace=@campus-errand/credit-service",
    "dev:notif": "npm run dev --workspace=@campus-errand/notification-service",
    "dev:apps": "npm run dev:student & npm run dev:admin & wait",
    "dev:services": "npm run dev:user & npm run dev:supplier & npm run dev:order & npm run dev:credit & npm run dev:notif & wait",
    "generate:jwt-keys": "node scripts/generate-jwt-keys.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node scripts/ci/run-all-tests.mjs",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:messaging": "npm run test:messaging --workspaces --if-present",
    "test:migration": "npm run test:migration --workspaces --if-present",
    "test:seed": "npm run test:seed --workspaces --if-present",
    "test:acceptance": "node scripts/uat/uat-d2-api.mjs && node scripts/uat/uat-notifications.mjs",
    "test:e2e:api": "npm run test:d2",
    "test:e2e:ui": "node scripts/uat/uat-d2-ui.mjs",
    "test:e2e": "node scripts/ci/run-all-tests.mjs --system-only",
    "ci:validate-tests": "node scripts/ci/validate-test-matrix.mjs",
    "db:generate": "npm run db:generate --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspaces --if-present",
    "db:deploy": "npm run db:deploy --workspaces --if-present",
    "db:seed": "npm run db:seed --workspaces --if-present",
    "postinstall": "npm run db:generate --workspaces --if-present",
    "test:d2": "tsx scripts/test-d2-e2e.ts"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/amqplib": "^0.10.5",
    "@types/node": "^20.14.0",
    "amqplib": "^0.10.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "pg": "^8.11.5",
    "playwright": "1.64.0",
    "tsx": "^4.11.0",
    "typescript-eslint": "^8.71.1"
  }
}
