            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const d=pm.response.json().data;pm.collectionVariables.set('token',d.accessToken);pm.collectionVariables.set('requesterId',d.user.userId);"
            ]
          }
        }
