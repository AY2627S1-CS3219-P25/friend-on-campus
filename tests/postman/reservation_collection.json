              "const d=pm.response.json().data;",
              "const attempts=Number(pm.collectionVariables.get('poll_'+pm.info.requestName)||0)+1;",
              "if(d.status==='PENDING' && attempts<100) {",
              " pm.collectionVariables.set('poll_'+pm.info.requestName,attempts); pm.execution.setNextRequest(pm.info.requestName);",
              "} else {",
              " pm.collectionVariables.unset('poll_'+pm.info.requestName);",
              " pm.test('Submission OPEN',()=>pm.expect(d.status).to.eql('OPEN'));",
              " pm.test(\"Confirmed order\",()=>{pm.expect(d.order.id).to.eql(d.id);pm.expect(d.order.status).to.eql(\"OPEN\");});",
