    {
      "name": "05 Select active supplier",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/suppliers"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const d=pm.response.json().data;const list=Array.isArray(d)?d:d.suppliers;const s=list.find(x=>x.isActive!==false);pm.test('Active supplier exists',()=>pm.expect(s).to.be.an('object'));pm.collectionVariables.set('supplierId',s.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Welcome grant",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/credits/wallet"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const d=pm.response.json().data;",
              "const n=Number(pm.collectionVariables.get('poll_'+pm.info.requestName)||0)+1;",
              "if((d.availableCredits!==100 || d.escrowCredits!==0) && n<100){pm.collectionVariables.set('poll_'+pm.info.requestName,n);pm.execution.setNextRequest(pm.info.requestName);}",
              "else {pm.collectionVariables.unset('poll_'+pm.info.requestName);pm.test('Wallet balances',()=>{pm.expect(d.availableCredits).to.eql(100);pm.expect(d.escrowCredits).to.eql(0);});}"
            ]
          }
        }
      ]
    },
