{
  "info": {
    "name": "Campus Errand - Credit Reservation Saga",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Runs against the local gateway. Run the complete collection in order with a 250ms request delay. Creates two uniquely named test accounts, uses an existing active supplier, and cancels all successfully created test orders to release holds. Test accounts and cancelled orders remain for inspection. Credentials are generated at runtime; no existing user credentials are needed. Poll loops stop after 100 attempts. New HTTP submissions are distinct operations; event replay idempotency is covered by the isolated reservation.messaging.test.ts suite. Broker downtime, late-success compensation and transaction failure injection are also covered by that suite.\n\nAI Assistance Disclosure: Codex (GPT-6), 2026-10-18. Scope: Reservation API assertions and local test fixtures. Author review: pending huangjiaxi1111."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Register dedicated requester",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"reserve_{{runId}}\", \"email\": \"{{email}}\", \"password\": \"{{password}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const stamp=Date.now().toString(36)+'_'+Math.random().toString(36).slice(2,7);",
              "pm.collectionVariables.set('runId',stamp);",
              "pm.collectionVariables.set('email','reserve_'+stamp+'@example.com');",
              "pm.collectionVariables.set('otherEmail','reserve_other_'+stamp+'@example.com');",
              "pm.collectionVariables.set('password','ReserveTest123!');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Login requester",
      "request": {
        "method": "POST",
        "header": [
          {
