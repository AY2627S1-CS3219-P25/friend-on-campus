# ─────────────────────────────────────────────────────────────
# FoC — Friend on Campus · Environment configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill in real values:   cp .env.example .env
#
# `.env` is git-ignored — NEVER commit real secrets.
# Any variable read by any service MUST appear here with a safe
# placeholder so teammates know what to set.
#
# This is just an example; you can add more variables as needed.
# ─────────────────────────────────────────────────────────────

# ---- Global -------------------------------------------------
LOG_LEVEL=

# ---- Auth / JWT -----------
# Ed25519 keys encoded as single-line Base64URL strings. Run
# `npm run generate:jwt-keys`, then paste the copied values below. Never commit
# the private key.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=friend-on-campus-user-service
JWT_AUDIENCE=friend-on-campus-services
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=1d
JWT_PERSISTENT_REFRESH_TOKEN_TTL=30d
CORS_ORIGIN=http://localhost:5173

# ---- User Service -----------
# Browser origin allowed to call user-service directly (not needed through the gateway / Vite proxies).
CORS_ORIGIN=http://localhost:5173

# ... Add more variables as needed
