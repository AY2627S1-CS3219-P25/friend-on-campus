# ─────────────────────────────────────────────────────────────
# FoC — Friend on Campus · Environment configuration (EXAMPLE)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` at the monorepo root and fill in real values:
#   cp .env.example .env
#
# `.env` is git-ignored — NEVER commit real secrets.
# All backend microservices and frontend apps load variables
# from this single root `.env` file during local development.
# ─────────────────────────────────────────────────────────────

# ---- Global -------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
# Optional global override; when unset, each service uses its dedicated RabbitMQ account on vhost `campus`:
# RABBITMQ_URL=amqp://user_service:user-service-dev@localhost:5672/campus

# ---- Auth / JWT ---------------------------------------------
# Ed25519 keys encoded as single-line Base64URL strings. Run
# `npm run generate:jwt-keys`, then paste the copied values below. Never commit
# the private key.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=friend-on-campus-user-service
JWT_AUDIENCE=friend-on-campus-services
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=1d
JWT_PERSISTENT_REFRESH_TOKEN_TTL=30d

# ---- Database Connections (Per-Service Least-Privilege Roles) ----
USER_DATABASE_URL=postgresql://user_svc:user-service-dev@localhost:5432/user_db
SUPPLIER_DATABASE_URL=postgresql://supplier_svc:supplier-service-dev@localhost:5432/supplier_db
ORDER_DATABASE_URL=postgresql://order_svc:order-service-dev@localhost:5432/order_db
CREDIT_DATABASE_URL=postgresql://credit_svc:credit-service-dev@localhost:5432/credit_db
NOTIFICATION_DATABASE_URL=postgresql://notification_svc:notification-service-dev@localhost:5432/notification_db

# ---- Service Ports & Specific Settings ----------------------
USER_SERVICE_PORT=8001
SUPPLIER_SERVICE_PORT=8002
ORDER_SERVICE_PORT=8003
CREDIT_SERVICE_PORT=8004
NOTIFICATION_SERVICE_PORT=8005

SUPPLIER_SERVICE_URL=http://localhost:8002
CREDIT_SERVICE_URL=http://localhost:8004

# Set true when running `docker compose --profile cdc up` so order-service relies on Debezium CDC instead of polling outbox_events:
OUTBOX_CDC_ENABLED=false

# ---- Student App --------------------------------------------
# false hides the "WS Hub: connected" status line in the header (a development aid). Default: shown.
VITE_SHOW_WS_STATUS=true
