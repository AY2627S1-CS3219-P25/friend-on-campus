# ---- Global -------------------------------------------------
LOG_LEVEL=

# ---- Auth / Session -------
# Symmetric session secret (at least 32 characters) for stateless session cookies:
# Generate one with: openssl rand -base64 48   (required; avoid ", \ and $ to ensure clean NGINX substitution; Compose refuses to start without it)
SESSION_SECRET=

# Internal gateway authentication key shared between NGINX and backend microservices:
# Generate one with: openssl rand -base64 32   (required; avoid ", \ and $ to ensure clean NGINX substitution; Compose refuses to start without it)
GATEWAY_KEY=

JWT_ISSUER=friend-on-campus-user-service
JWT_AUDIENCE=friend-on-campus-services
SESSION_TTL=1d
JWT_ACCESS_TOKEN_TTL=1d
JWT_REFRESH_TOKEN_TTL=1d
JWT_PERSISTENT_REFRESH_TOKEN_TTL=30d
CORS_ORIGIN=http://localhost:5173

# ---- User Service -----------
# Browser origin allowed to call user-service directly (not needed through the gateway / Vite proxies).
CORS_ORIGIN=http://localhost:5173

# ... Add more variables as needed
