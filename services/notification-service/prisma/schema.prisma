generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One inbox row per intended recipient of one event.
model Notification {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // The recipient.
  userId        String    @map("user_id") @db.Uuid
  // The owning service of the event (dedup scope with eventId).
  producer      String    @default("order-service")
  eventId       String    @map("event_id") @db.Uuid
  kind          String
  orderId       String    @map("order_id") @db.Uuid
  orderCode     String?   @map("order_code")
  courierId     String?   @map("courier_id") @db.Uuid
  title         String
  body          String
  // PROGRESS | ACTION | IMPORTANT
  category      String
  // NORMAL | HIGH
  priority      String
  // VIEW_ERRAND | REVIEW_DELIVERY | REVIEW_WALLET, or null
  actionType    String?   @map("action_type")
  // The order the action opens.
  targetId      String?   @map("target_id") @db.Uuid
  // The committed order version the event carried; null for version-1 events.
  sourceVersion Int?      @map("source_version")
  // Null means unread.
  readAt        DateTime? @map("read_at") @db.Timestamptz(6)
  // The event's timestamp (occurrence time), kept for compatibility.
  createdAt     DateTime  @map("created_at") @db.Timestamptz(6)
  // When this row was stored; the inbox orders and pages by it.
  storedAt      DateTime  @default(now()) @map("stored_at") @db.Timestamptz(6)

  @@unique([producer, eventId, userId, kind])
  @@index([userId, storedAt(sort: Desc), id(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}

/// Every event the consumer has seen, created or suppressed, so replay is a no-op and a changed payload is detected.
model ProcessedNotificationEvent {
  producer      String
  eventId       String   @map("event_id") @db.Uuid
  // sha256 of the normalized event; null for rows backfilled from legacy notifications.
  fingerprint   String?
  schemaVersion Int      @map("schema_version")
  policyVersion Int      @map("policy_version")
  // created | suppressed | legacy
  outcome       String
  processedAt   DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([producer, eventId])
  @@map("processed_notification_events")
}

/// The latest committed order state this service has seen; removes stale inbox actions, never authorizes commands.
model OrderNotificationState {
  orderId             String   @id @map("order_id") @db.Uuid
  highestOrderVersion Int      @map("highest_order_version")
  status              String
  requesterId         String   @map("requester_id") @db.Uuid
  courierId           String?  @map("courier_id") @db.Uuid
  updatedAt           DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("order_notification_state")
}
