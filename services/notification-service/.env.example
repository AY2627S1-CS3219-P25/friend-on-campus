# AI Assistance Disclosure:
# Tool: Claude Code (model: Claude Fable 5.1), date: 2026-10-05
# Scope: Documented the Notification Service's database, RabbitMQ identity and access-token verification settings,
# following services/credit-service/.env.example.
# Author review: <to be completed by Reallyeasy1>

PORT=8005
# Created by docker/postgres-init on a fresh volume; `npm run db:deploy` creates it on an existing one.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/notification_db

# Same public key as User Service; never configure its private key here.
JWT_PUBLIC_KEY=
JWT_ISSUER=friend-on-campus-user-service
JWT_AUDIENCE=friend-on-campus-services

# Development-only account provisioned by docker/rabbitmq/definitions.json.
RABBITMQ_URL=amqp://notification_service:notification-service-dev@localhost:5672/campus
NOTIFICATION_EXCHANGE=campus.events
NOTIFICATION_QUEUE=notification-service.events
NOTIFICATION_RETRY_EXCHANGE=notification-service.events.retry
NOTIFICATION_RETRY_QUEUE=notification-service.events.retry
NOTIFICATION_DLX=notification-service.events.dlx
NOTIFICATION_DLQ=notification-service.events.dlq
NOTIFICATION_RETRY_DELAY_MS=1000
NOTIFICATION_RETRY_LIMIT=5
