// AI Assistance Disclosure:
// Tool: Claude Code (model: Claude Fable 5.1), date: 2026-10-20 to 2026-11-09
// Scope: The conversation and message tables as the author specified them in the F8 brief (S1, S2, answered in chat on 2026-10-20): one conversation per order..; updated across 3 AI-assisted revisions through D4 wrap-up (realtimeOutbox (realtime_outbox), the delivery-intent table for cross-replica chat delivery (issue #240)).
// Author review: I validated correctness, edited for style, and verified with automated tests.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// S1: created by the consumer when order.accepted arrives; a redelivered or repeated accept finds the row by order id.
model Conversation {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String    @unique @map("order_id") @db.Uuid
  requesterId String    @map("requester_id") @db.Uuid
  // Kept after an admin unassign until the next order.accepted replaces it (author's S1 answer 2).
  courierId   String    @map("courier_id") @db.Uuid
  // When the current courier was assigned (the accept event's timestamp); an accept older than this is a replay.
  courierSince DateTime @map("courier_since") @db.Timestamptz(6)
  createdAt   DateTime  @map("created_at") @db.Timestamptz(6)
  // S3 answer 1: order.in_transit and order.delivered are recorded on the row (names as in OrderDTO).
  pickedUpAt  DateTime? @map("picked_up_at") @db.Timestamptz(6)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)
  // Null means open; set by order.completed, order.cancelled or order.expired (S1 answers 3 and 4).
  closedAt    DateTime? @map("closed_at") @db.Timestamptz(6)
  messages    Message[]

  @@map("conversations")
}

// S2: append-only; ordered by sequence within a conversation.
model Message {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  // Per-conversation sequence number, the ordering tiebreaker (S2 answer 3).
  sequence       Int
  senderId       String       @map("sender_id") @db.Uuid
  // Copied from the access token at send time (D6, S2 answer 2).
  senderUsername String       @map("sender_username")
  senderRole     String       @map("sender_role")
  text           String
  // Server receive time (F8.2.2).
  sentAt         DateTime     @map("sent_at") @db.Timestamptz(6)

  @@unique([conversationId, sequence])
  @@map("messages")
}

// Issue #240: a realtime delivery intent committed in the same transaction as the row it announces. Relays in every
// replica lease rows (lease_owner, lease_expires_at), publish them to the fanout exchange and delete them with an
// owner check; a failed publish moves available_at forward. Replay after a lost lease is expected and deduplicated.
model RealtimeOutbox {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId        String    @unique @map("event_id") @db.Uuid
  kind           String
  payload        Json
  attempts       Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  availableAt    DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  leaseOwner     String?   @map("lease_owner")
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(6)

  @@index([availableAt, createdAt])
  @@map("realtime_outbox")
}
