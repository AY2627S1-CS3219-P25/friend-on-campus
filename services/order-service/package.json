{
  "name": "@campus-errand/order-service",
  "version": "1.0.0",
  "private": true,
  "description": "Order Lifecycle State Machine Microservice for NUS CampusErrand",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "build": "tsc",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "node ../../scripts/prisma-migrate.mjs order dev",
    "db:deploy": "node ../../scripts/prisma-migrate.mjs order deploy",
    "db:seed": "tsx src/database/seed.ts",
    "test:unit": "node --import tsx --test test/app.test.ts test/order.service.test.ts",
    "test:messaging": "tsx test/reservation.messaging.test.ts"
  },
  "dependencies": {
    "@campus-errand/auth": "*",
    "@campus-errand/common-dtos": "*",
    "@campus-errand/messaging": "*",
    "@prisma/client": "^6.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "prisma": "^6.7.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "amqplib": "^0.10.4",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  }
}
