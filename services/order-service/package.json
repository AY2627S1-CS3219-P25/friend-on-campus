{
  "name": "@campus-errand/order-service",
  "version": "1.0.0",
  "description": "Order Lifecycle State Machine Microservice for NUS CampusErrand",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "db:generate": "prisma generate --schema src/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema src/database/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema src/database/prisma/schema.prisma",
    "db:seed": "tsx src/database/seed.ts",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@campus-errand/auth": "*",
    "@campus-errand/common-dtos": "*",
    "@prisma/client": "^6.7.0",
    "amqplib": "^0.10.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "prisma": "^6.7.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  }
}
