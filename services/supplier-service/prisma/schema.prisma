//
// Prisma schema for the supplier-service PostgreSQL database.
// Lives at the standard ./prisma/schema.prisma location.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// One row per supplier / campus location. Columns map 1:1 to the seed CSV.
// TODO: finalise field types/constraints (e.g. structured opening hours) once requirements settle.
model Supplier {
  id            String   @id @default(uuid())
  supplierCode  String   @unique @map("supplier_code")
  name          String
  campusZone    String   @map("campus_zone")
  exactLocation String   @map("exact_location")
  category      String
  description   String?
  building      String
  floor         String
  latitude      Float?
  longitude     Float?
  startingTime  String?  @map("starting_time")
  closingTime   String?  @map("closing_time")
  imageUrl      String?  @map("image_url")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("suppliers")
}
