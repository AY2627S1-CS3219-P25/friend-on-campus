{
  "name": "@campus-errand/supplier-service",
  "version": "1.0.0",
  "private": true,
  "description": "Supplier & Campus Location Directory Microservice for NUS CampusErrand",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test:unit": "node --import tsx --experimental-test-module-mocks --test \"test/**/*.test.ts\"",
    "build": "tsc",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "node -e \"require('dotenv').config({path:['.env','../../.env']});process.env.DATABASE_URL||=process.env.SUPPLIER_DATABASE_URL||'postgresql://supplier_svc:supplier-service-dev@localhost:5432/supplier_db';const r=require('node:child_process').spawnSync(process.execPath,[require.resolve('prisma/build/index.js'),'migrate','dev','--schema','prisma/schema.prisma',...process.argv.slice(1)],{stdio:'inherit'});process.exit(r.status??1)\"",
    "db:deploy": "node -e \"require('dotenv').config({path:['.env','../../.env']});process.env.DATABASE_URL||=process.env.SUPPLIER_DATABASE_URL||'postgresql://supplier_svc:supplier-service-dev@localhost:5432/supplier_db';const r=require('node:child_process').spawnSync(process.execPath,[require.resolve('prisma/build/index.js'),'migrate','deploy','--schema','prisma/schema.prisma',...process.argv.slice(1)],{stdio:'inherit'});process.exit(r.status??1)\"",
    "db:seed": "tsx src/database/seed.ts"
  },
  "dependencies": {
    "@campus-errand/auth": "*",
    "@campus-errand/common-dtos": "*",
    "@prisma/client": "^6.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "prisma": "^6.7.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  }
}
