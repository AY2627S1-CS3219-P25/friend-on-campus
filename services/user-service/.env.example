# Used when running the User Service directly with npm run dev:user or from this directory.
PORT=8001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/user_db

# Copy the matching local-development key pair from the repository-root .env file.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=friend-on-campus-user-service
JWT_AUDIENCE=friend-on-campus-services
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=1d
JWT_PERSISTENT_REFRESH_TOKEN_TTL=30d

# Browser origin allowed to call this service directly (the Vite proxies and the gateway are same-origin).
CORS_ORIGIN=http://localhost:5173

# RabbitMQ configuration for event publishing
RABBITMQ_URL=amqp://user_service:user-service-dev@localhost:5672/campus
EVENTS_EXCHANGE=campus.events
