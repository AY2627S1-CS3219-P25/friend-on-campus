generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// `username` and `email` are unique case-insensitively via the expression indexes
// users_username_case_insensitive_uq and users_email_case_insensitive_uq on LOWER(...), created in the
// migration SQL under migrations/ and in docker/postgres-init/01-init-databases.sql. Prisma cannot express
// an expression index, so they are deliberately not `@unique` here; look-ups must go through LOWER(email)
// (see auth-repository.findUserByEmail) and duplicate errors arrive as Postgres 23505 with the constraint name.
model User {
  id           String    @id @default(uuid()) @db.Uuid
  username     String    @db.VarChar(50)
  email        String    @db.VarChar(320)
  passwordHash String    @map("password_hash")
  role         String    @default("STUDENT") @db.VarChar(20)
  status       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions     Session[]

  @@map("users")
}

model Session {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  refreshTokenHash String   @unique @map("refresh_token_hash")
  persistent       Boolean  @default(false)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt       DateTime @default(now()) @map("last_used_at") @db.Timestamptz(6)
  idleExpiresAt    DateTime @map("idle_expires_at") @db.Timestamptz(6)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, idleExpiresAt], map: "sessions_user_expiry_idx")
  @@map("sessions")
}
