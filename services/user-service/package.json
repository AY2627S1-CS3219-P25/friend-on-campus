{
  "name": "@campus-errand/user-service",
  "version": "1.0.0",
  "private": true,
  "description": "User & Authentication Microservice for NUS CampusErrand",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test:unit": "node --import tsx --test test/app.test.ts test/auth-module.test.ts test/password.test.ts test/tokens.test.ts test/user-module.test.ts test/validation.test.ts",
    "test:integration": "node --import tsx --test test/admin-guard.integration.test.ts",
    "build": "tsc",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "node ../../scripts/prisma-migrate.mjs user dev",
    "db:deploy": "node ../../scripts/prisma-migrate.mjs user deploy",
    "db:seed": "tsx src/database/seed.ts"
  },
  "dependencies": {
    "@campus-errand/auth": "*",
    "@campus-errand/common-dtos": "*",
    "@prisma/client": "^6.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "prisma": "^6.7.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  }
}
