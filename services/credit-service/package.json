{
  "name": "@campus-errand/credit-service",
  "version": "1.0.0",
  "private": true,
  "description": "Closed Credit Economy Ledger & Escrow Vault Microservice for NUS CampusErrand",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "build": "tsc",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "node ../../scripts/prisma-migrate.mjs credit dev",
    "db:deploy": "node ../../scripts/prisma-migrate.mjs credit deploy",
    "db:seed": "tsx src/database/seed.ts",
    "test:seed": "tsx tests/seed.integration.test.ts",
    "test:integration": "tsx tests/credits.integration.test.ts",
    "test:messaging": "tsx tests/messaging.integration.test.ts",
    "test:migration": "tsx tests/migration.integration.test.ts"
  },
  "dependencies": {
    "@campus-errand/auth": "*",
    "@campus-errand/common-dtos": "*",
    "@campus-errand/messaging": "*",
    "@prisma/client": "^6.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "prisma": "^6.7.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "amqplib": "^0.10.4",
    "pg": "^8.11.5",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  }
}
