{
  "name": "@campus-errand/credit-service",
  "version": "1.0.0",
  "description": "Closed Credit Economy Ledger & Escrow Vault Microservice for NUS CampusErrand",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --project tsconfig.test.json",
    "build": "tsc",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "node -e \"require('dotenv').config({path:['.env','../../.env']});process.env.DATABASE_URL||=process.env.CREDIT_DATABASE_URL||'postgresql://credit_svc:credit-service-dev@localhost:5432/credit_db';const r=require('node:child_process').spawnSync(process.execPath,[require.resolve('prisma/build/index.js'),'migrate','dev','--schema','prisma/schema.prisma',...process.argv.slice(1)],{stdio:'inherit'});process.exit(r.status??1)\"",
    "db:deploy": "node -e \"require('dotenv').config({path:['.env','../../.env']});process.env.DATABASE_URL||=process.env.CREDIT_DATABASE_URL||'postgresql://credit_svc:credit-service-dev@localhost:5432/credit_db';const r=require('node:child_process').spawnSync(process.execPath,[require.resolve('prisma/build/index.js'),'migrate','deploy','--schema','prisma/schema.prisma',...process.argv.slice(1)],{stdio:'inherit'});process.exit(r.status??1)\"",
    "db:seed": "tsx src/database/seed.ts",
    "test:seed": "tsx tests/seed.integration.test.ts",
    "test:integration": "tsx tests/credits.integration.test.ts",
    "test:messaging": "tsx tests/messaging.integration.test.ts",
    "test:migration": "tsx tests/migration.integration.test.ts"
  },
  "dependencies": {
    "@campus-errand/auth": "*",
    "@campus-errand/common-dtos": "*",
    "@prisma/client": "^6.7.0",
    "express": "^4.21.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "pg": "^8.11.5",
    "amqplib": "^0.10.4",
    "prisma": "^6.7.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/amqplib": "^0.10.5",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  }
}
