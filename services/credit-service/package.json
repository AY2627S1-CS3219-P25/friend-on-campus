{
  "name": "@campus-errand/credit-service",
  "version": "1.0.0",
  "description": "Closed Credit Economy Ledger & Escrow Vault Microservice for NUS CampusErrand",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "db:generate": "prisma generate --schema src/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema src/database/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema src/database/prisma/schema.prisma",
    "db:baseline": "prisma migrate resolve --applied 20260924050000_existing_credit_tables --schema src/database/prisma/schema.prisma",
    "test:integration": "tsx src/credits/credits.integration.test.ts"
  },
  "dependencies": {
    "@campus-errand/common-dtos": "*",
    "@prisma/client": "^6.7.0",
    "express": "^4.21.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "pg": "^8.11.5",
    "amqplib": "^0.10.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/amqplib": "^0.10.5",
    "prisma": "^6.7.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  }
}
