PORT=8004
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/credit_db
# Same public key as User Service; never configure its private key here.
JWT_PUBLIC_KEY=
JWT_ISSUER=friend-on-campus-user-service
JWT_AUDIENCE=friend-on-campus-services
# Development-only account provisioned by docker/rabbitmq/definitions.json.
RABBITMQ_URL=amqp://credit_service:credit-service-dev@localhost:5672/campus
CREDIT_EXCHANGE=campus.events
CREDIT_QUEUE=credit-service.events
CREDIT_RETRY_EXCHANGE=credit-service.events.retry
CREDIT_RETRY_QUEUE=credit-service.events.retry
CREDIT_DLX=campus.events.dlx
CREDIT_DLQ=credit-service.events.dlq
CREDIT_RETRY_DELAY_MS=1000
CREDIT_RETRY_LIMIT=5
